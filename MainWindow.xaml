<Window x:Class="Safonova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Решение транспортной задачи" Height="800" Width="1000">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock Text="Матрица затрат:" Margin="0,0,0,10" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Добавить строку (источник)" Click="AddRow_Click"/>
                    <Button Content="Добавить столбец (пункт назначения)" Margin="5,0,0,0" Click="AddColumn_Click"/>
                </StackPanel>
                <DataGrid x:Name="costMatrixGrid" AutoGenerateColumns="True" CanUserAddRows="True" CanUserDeleteRows="True" Height="200"/>

                <TextBlock Text="Запасы (источники):" Margin="0,10,0,5" FontWeight="Bold"/>
                <DataGrid x:Name="supplyGrid" AutoGenerateColumns="True" CanUserAddRows="True" CanUserDeleteRows="True" Height="100"/>

                <TextBlock Text="Потребности (пункты назначения):" Margin="0,10,0,5" FontWeight="Bold"/>
                <DataGrid x:Name="demandGrid" AutoGenerateColumns="True" CanUserAddRows="True" CanUserDeleteRows="True" Height="100"/>

                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button x:Name="northWestButton" Content="Метод северо-западного угла" Margin="0,0,10,0" Click="NorthWestButton_Click"/>
                    <Button x:Name="minElementButton" Content="Метод минимального элемента" Click="MinElementButton_Click"/>
                </StackPanel>

                <TextBlock Text="Результат:" Margin="0,20,0,10" FontWeight="Bold"/>
                <DataGrid x:Name="resultDataGrid" AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False" Margin="0,0,0,10"/>
                <TextBlock x:Name="totalCostTextBlock" FontWeight="Bold"/>
            </StackPanel>
        https://math.semestr.ru/transp/index.php transport
        https://math.semestr.ru/simplex/simplex.php simplex
        </ScrollViewer>
    </Grid>
</Window>
